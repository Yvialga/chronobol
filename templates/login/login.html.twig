{% extends 'base.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block body %}
<main class="flex justify-center items-center w-full min-h-screen ">
    <div class="{% if app.user %} w-md {% else %} w-sm {% endif %} p-6 -translate-y-10">
        {% if app.user %}
            <div class="mb-3 flex flex-col items-center w-full">
                <p>Vous êtes déjà authentifié en tant que <span class="font-bold">{{ app.user.username }}</span></p>
                <div class="flex gap-x-4">
                    <a class="underline link-primary hover:no-underline underline-offset-1" href="{{ path('app_event_home') }}">Accéder à la liste des compétitions</a>
                    <a class="underline link-error hover:no-underline underline-offset-1" href="{{ path('app_logout') }}">Se déconnecter</a>
                </div>
            </div>
        {% else %}
        <form method="post" class="flex flex-col gap-6">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <img src="{{ asset('images/CKC_logo.png') }}" alt="Logo du Club de Kayak">

            <fieldset class="flex flex-col gap-y-2">
                <label for="username">Nom d'utilisateur</label>
                <input type="text" value="{{ last_username }}" name="_username" id="username" autocomplete="username" placeholder="UserAdmin" autofocus class="input"/>
                    <!--class="text-gray-900 border border-zinc-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" {# fin ici #}-->

            </fieldset>
            <fieldset class="flex flex-col gap-y-2">
                <label for="password">Mot de passe</label>
                <input
                    type="password" name="_password"  id="password" class="input" autocomplete="current-password" placeholder="MotDePasse123">
            </fieldset>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            {#
                Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                See https://symfony.com/doc/current/security/remember_me.html

                <div class="checkbox mb-3">
                    <input type="checkbox" name="_remember_me" id="_remember_me">
                    <label for="_remember_me">Remember me</label>
                </div>
            #}

            <button class="btn btn-lg btn-primary" type="submit">
                Se connecter
            </button>
        </form>
        {% endif %}
    </div>
</main>
{% endblock %}
