{% extends 'authenticated_user.html.twig' %}

{% block title %}Pointage{% endblock %}

{% block specificjs %}<script defer src="{{ asset('js/checkin.js') }}"></script>{% endblock %}

{% block item %}
    {{ include('layout/global.html.twig') }}
{% endblock %}

{% block main %}
    <section class="m-8">
        <h1 class="text-center font-bold text-4xl mt-4 mb-12">Pointage</h1>
        <div class="flex gap-4">
            {{ form_start(form, {
                action: path('app_event_checkin', {slug: event.slug}),
                attr: {
                    'class': 'flex justify-center',
                    id: 'form-of-checkin'
                }
            }) }}
                <fieldset class="flex flex-col items-start">
                    {{ form_label(form.checkin, 'Pointage') }}
                    {{ form_widget(form.checkin, {attr: {
                        'autofocus': true,
                        'class': 'border rounded-sm'
                    }}) }}
                    <p class="error">{{ form_errors(form.checkin) }}</p>
                </fieldset>
            {{ form_end(form) }}

            {{ form_start(manualForm, {
                attr: {
                    class: 'flex flex-col items-start bg-sky-200 p-2'
                }
            }) }}
                <p>Saisie manuelle</p>
                <fieldset>
                    {{ form_label(manualForm.bib_number, 'Numéro de dossard') }}
                    {{ form_widget(manualForm.bib_number, {attr: {
                        'class': 'input'
                    }}) }}
                </fieldset>
                <fieldset>
                    {{ form_label(manualForm.captain, 'Capitaine/Équipier') }}
                    {{ form_widget(manualForm.captain) }}
                </fieldset>
                <button class="btn">{{ button_label|default('Ok') }}</button>
            {{ form_end(manualForm) }}
        </div>

        {{ include('check/_name_field.html.twig') }}
    </section>
{% endblock %}
