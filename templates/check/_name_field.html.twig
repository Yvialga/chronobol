<div class="flex items-center justify-center">
    <div id="verif-output" class="flex items-center flex-col justify-center mt-16 w-max gap-y-4">
        <p class="text-5xl"><span id="name" {# name/lastname #}></span> <span id="lastname" class="uppercase"></span></p>

        {% if 'verif' in app.request.pathinfo %} {# Here, we display information like below only for verification page #}
            <p id="bib-line" class="invisible text-4xl flex items-center gap-x-2 w-full">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shirt"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                <span id="bib-print" class="font-bold"></span>
            </p>
            <p id="trail-line" class="invisible text-4xl flex items-center gap-x-2 w-full">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-road"><path d="M12 17v4"/><path d="M12 5V3"/><path d="M12 9v3"/><path d="M2.077 18.449A2 2 0 0 0 4 21h16a2 2 0 0 0 1.924-2.55l-4-14A2 2 0 0 0 16 3H8a2 2 0 0 0-1.924 1.45z"/></svg>
                <span id="trail-print"></span>
            </p>
            <div id="typo-link-container"></div>
        {% endif %}
    </div>
</div>
