{% extends 'authenticated_user.html.twig' %}

{% block title %}Compétition{% endblock %}

{% block main %}
    <section class="m-8">
        <a class="underline hover:no-underline" href="{{ path('app_event_home') }}">Retour à la liste</a>

        <div class="mb-6">
            <div class="flex flex-col gap-y-6">
                <div class="mt-4">
                    <p>Récap</p>
                    <div class="flex gap-x-2 items-center">
                        <p>Compétition :</p>
                        <h1 class="font-semibold text-3xl">{{ event.name }}</h1>
                    </div>
                </div>
                <div class="flex gap-x-2 items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days-icon lucide-calendar-days"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
                    <p class="font-xl">{{ event.date ? event.date|date('d/m/Y') : '' }}</p>
                </div>
                {% set trails = event.fktrailid %}
                {% if trails %}
                    <ul class="flex flex-col gap-y-2">
                        {% for trail in trails %}
                            <li>
                                <span class="uppercase text-xl">{{ trail.name }}</span>
                                <span>{{ trail.starttime|date('H:i') }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>

        <ul class="grid grid-flow-col grid-cols-3 grid-rows-3 w-fit">
            <li class="btn w-md"><a class="flex gap-x-1 justify-center items-center w-full h-full p-2" href="{{ path('app_team_new', {slug: event.slug }) }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-plus-icon lucide-user-plus"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
                    Inscrire une équipe
            </a></li>
            <li class="btn w-md row-span-2"><a class="flex gap-x-1 justify-center items-center w-full h-full p-2" href="{{ path('app_team_index', {slug: event.slug }) }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users-round-icon lucide-users-round"><path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3"/></svg>
                    Liste des équipes
            </a></li>
            <li class="btn w-md"><a class="flex gap-x-1 justify-center items-center w-full h-full p-2" href="{{ path('app_event_verif', {slug: event.slug }) }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-fingerprint-pattern-icon lucide-fingerprint-pattern"><path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"/><path d="M14 13.12c0 2.38 0 6.38-1 8.88"/><path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"/><path d="M2 12a10 10 0 0 1 18-6"/><path d="M2 16h.01"/><path d="M21.8 16c.2-2 .131-5.354 0-6"/><path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"/><path d="M8.65 22c.21-.66.45-1.32.57-2"/><path d="M9 6.8a6 6 0 0 1 9 5.2v2"/></svg>
                    Vérifier un puce
            </a></li>
            <li class="btn w-md row-span-2"><a class="flex gap-x-1 justify-center items-center w-full h-full p-2" href="#">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play-icon lucide-play"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></svg>
                    Gestion des départs
            </a></li>
            <li class="btn w-md"><a class="flex gap-x-1 justify-center items-center w-full h-full p-2" href="{{ path('app_event_checkin', {slug: event.slug}) }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-radio-icon lucide-radio"><path d="M16.247 7.761a6 6 0 0 1 0 8.478"/><path d="M19.075 4.933a10 10 0 0 1 0 14.134"/><path d="M4.925 19.067a10 10 0 0 1 0-14.134"/><path d="M7.753 16.239a6 6 0 0 1 0-8.478"/><circle cx="12" cy="12" r="2"/></svg>
                    Pointage
            </a></li>
            <li class="btn w-md"><a class="flex gap-x-1 justify-center items-center w-full h-full p-2" href="{{ path('app_ranking', {slug: event.slug}) }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-podium-icon lucide-podium"><path d="M12 6V2h-1"/><path d="M9 15a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1"/><path d="M9 21V11a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v10"/></svg>
                    Classement
            </a></li>
        </ul>

        {% if is_granted('ROLE_ADMIN') %}
            <div class="flex">
                <a class="btn" href="{{ path('app_event_edit', {'id': event.id}) }}">Modifier la compétition</a>
                {{ include('event/_delete_form.html.twig') }}
            </div>
        {% endif %}
    </section>

{% endblock %}
