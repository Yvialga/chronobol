{% extends 'authenticated_user.html.twig' %}

{% block title %}Liste des compétitions{% endblock %}

{% block main %}
    <h1>Liste des compétitions</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom de la compétition</th>
                <th>Date</th>
                <th>"slug"</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for event in events %}
            <tr>
                <td>{{ event.id }}</td>
                <td>{{ event.eventName }}</td>
                <td>{{ event.eventDate ? event.eventDate|date('Y-m-d') : '' }}</td>
                <td>{{ event.eventSlug }}</td>
                <td>
                    <a href="{{ path('app_event_show', {'slug': event.eventSlug, 'id': event.id}) }}">Afficher</a>
                    <a href="{{ path('app_event_edit', {'id': event.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucun évènement trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_event_new') }}">Créer une nouvelle compétition</a>
{% endblock %}
