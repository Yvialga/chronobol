{% extends 'base.html.twig' %}

{% block title %}Compétition{% endblock %}

{% block body %}
    <h1>Compétition</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ event.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ event.eventName }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ event.eventDate ? event.eventDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>"slug"</th>
                <td>{{ event.eventSlug }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_event_index') }}">Retour à la liste</a>

    <a href="{{ path('app_event_edit', {'id': event.id}) }}">Modifier la compétition</a>

    {{ include('event/_delete_form.html.twig') }}
{% endblock %}
