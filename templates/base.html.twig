<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Chronobol - Chronométrage du Bol d'Air{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            {# Below, JS code is restricted to a specific page to prevent it from being loaded on all pages that do not use it. #}
            {% block specificjs %}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-amber-50">
        {% block body %}{% endblock %}
    </body>
</html>
