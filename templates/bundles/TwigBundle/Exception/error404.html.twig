{% extends 'base_for_error.html.twig' %}

{% block title %}Page introuvable - Chronobol{% endblock %}

{% block status_code %}404{% endblock %}
{% block status_text %}Page introuvable{% endblock %}
{% block text %}
    Vérifiez qu'il n'y a pas de faute de frappe dans l'URL ou
    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        <a class="underline hover:no-underline" href="{{ path('app_event_home') }}">retournerz sur l'accueil</a>
    {% else %}
        <a class="underline hover:no-underline" href="{{ path('app_login') }}">connectez-vous</a>
    {% endif %}.
{% endblock %}