{% extends 'authenticated_user.html.twig' %}

{% block title %}Nouvel utilisateur{% endblock %}

{% block main %}
    <h1>Créer un nouvel utilisateur</h1>

    {{ form_errors(form) }}

    {{ form_start(form) }}
        {{ form_row(form.username, {
            label: 'Nom d\'utilisateur'
        }) }}
        {{ form_row(form.password, {
            label: 'Mot de passe'
        }) }}
        {{ form_row(form.roles, {
            label: 'Role'
        }) }}

        <button type="submit" class="btn">Sauvegarder</button>
    {{ form_end(form) }}

    <a href="{{ path('app_user_index') }}">Retourner sur la liste des utilisateurs</a>
{% endblock %}
